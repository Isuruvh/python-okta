# Okta Configuration
# Copy this file to .env and fill in your Okta application credentials

# Your Okta organization domain
# Example: https://dev-123456.okta.com
OKTA_ISSUER=https://your-okta-domain.okta.com/oauth2/default

# OAuth 2.0 Client ID
# Found in your Okta application settings
OKTA_CLIENT_ID=0oaXXXXXXXXXXXXXXXXX

# OAuth 2.0 Client Secret
# Found in your Okta application settings
OKTA_CLIENT_SECRET=your_client_secret_here_keep_it_safe

# Authorization endpoint
# Usually: https://your-okta-domain.okta.com/oauth2/default/v1/authorize
OKTA_AUTH_URI=https://your-okta-domain.okta.com/oauth2/default/v1/authorize

# Token endpoint
# Usually: https://your-okta-domain.okta.com/oauth2/default/v1/token
OKTA_TOKEN_URI=https://your-okta-domain.okta.com/oauth2/default/v1/token

# UserInfo endpoint
# Usually: https://your-okta-domain.okta.com/oauth2/default/v1/userinfo
OKTA_USERINFO_URI=https://your-okta-domain.okta.com/oauth2/default/v1/userinfo

# OAuth 2.0 Redirect URI
# Must match exactly with what you configured in Okta
# For local development: http://127.0.0.1:5000/authorization-code/callback
# For production: https://yourdomain.com/authorization-code/callback
OKTA_REDIRECT_URI=http://127.0.0.1:5000/authorization-code/callback
